# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=123456789012345678

# Character Preset ("default" loads presets/default.json)
CHARACTER_PRESET=default

# Schedule & Location Settings
CYCLE_END_HOUR=22
DEFAULT_LOCATION=Chicago, IL
TIMEZONE_LABEL=Central Time

# Local LM Studio Configuration
LM_STUDIO_URL=http://127.0.0
LM_STUDIO_PORT=1234
LLM_MODEL=google/gemma-4-e2b

# Overseer Hardware Telemetry Settings
OVERSEER_WEBHOOK_URL=https://discord.com
OVERSEER_VRAM_THRESHOLD=85.0
OVERSEER_RAM_THRESHOLD=85.0
OVERSEER_SUSTAINED_SECONDS=10
OVERSEER_POLL_INTERVAL=2.0
OVERSEER_ALERT_COOLDOWN=300
