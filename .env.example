# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=123456789012345678

# Character Preset ("default" loads presets/default.json)
CHARACTER_PRESET=default

# Schedule & Location Settings
CYCLE_END_HOUR=22
DEFAULT_LOCATION=Chicago, IL
TIMEZONE_LABEL=Central Time

# Local LM Studio Configuration
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_PORT=1234
LLM_MODEL=google/gemma-4-e2b

# Optional Free Cloud Fallback (Gemini API Free Tier — leave GEMINI_API_KEY blank for 100% local mode)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it
GEMINI_REASONING_EFFORT=minimal

# Overseer Hardware Telemetry Settings
OVERSEER_WEBHOOK_URL=https://discord.com
OVERSEER_VRAM_THRESHOLD=85.0
OVERSEER_RAM_THRESHOLD=85.0
OVERSEER_SUSTAINED_SECONDS=10
OVERSEER_POLL_INTERVAL=2.0
OVERSEER_ALERT_COOLDOWN=300

# Offloader & Thermal Reload Gate Settings (offloader.py)
OFFLOADER_AUTO_RELOAD=true
OFFLOADER_POLL_INTERVAL=1.0
OFFLOADER_RELOAD_COOLDOWN=20.0
RELOAD_MAX_GPU_TEMP_C=60

# Overseer Baseline Drift & Sampling Settings (overseer.py)
OVERSEER_SAMPLE_INTERVAL=10.0
OVERSEER_DRIFT_DELTA=25.0
OVERSEER_MIN_BASELINE_SAMPLES=60

# Gaming Session Milestone Tracker
SESSION_REMINDER_ENABLED=true
SESSION_REMARK_MINS=120
SESSION_ESCALATE_MINS=240
SESSION_GRACE_MINS=5
